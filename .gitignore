# in Supabase Storage rather than in git.
workbook-data.json

# Loader artifacts — regenerated, and the progress file is machine-local state
dryrun/
dryrun-progress.json
load_supabase_progress.json

# Production web app — build output, deps, and the local test fixture
web/node_modules/
web/dist/
web/fixture/
web/shots/
dryrun-screens/
