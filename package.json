{
  "name": "meridian-pipeline",
  "private": true,
  "version": "1.0.0",
  "description": "Meridian data pipeline — loaders, the compute step, and the daily job. The web app lives in web/.",
  "type": "module",
  "scripts": {
    "load": "node --max-old-space-size=4096 load_supabase.mjs",
    "compute": "node --max-old-space-size=6144 compute_and_publish.mjs",
    "daily": "node --max-old-space-size=4096 daily_fetch.mjs",
    "workbook": "node --max-old-space-size=6144 build_workbook.mjs && python3 build_workbook.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0"
  }
}
